# provision.env — configuration for setup-capella.sh
#
# HOW TO USE:
#   1. Copy this file:            cp provision.env.example provision.env
#   2. Fill the one required SECRET below (CB_API_KEY).
#   3. Run:                       source provision.env && ./setup-capella.sh
#
# Every line is `export` so `source provision.env` loads them into your shell,
# and setup-capella.sh reads them as environment variables.
#
# TO CUSTOMIZE ANY VALUE BELOW (including passwords): edit it directly in THIS
# FILE, then re-run `source provision.env`. Don't set it via `export` in your
# shell instead — `source provision.env` re-exports every line here, including
# blank ones, so it will silently overwrite a same-named shell export with
# whatever (or nothing) is written in this file.

# ── REQUIRED — you must fill this one ───────────────────────────────────────
export CB_API_KEY=''          # Capella API key SECRET: the base64 'APIKeyToken' / API Secret —
                              # NOT the 32-character Key ID. Org Owner role, or Project Owner with the
                              # CB_ORGANIZATION_ID / CB_PROJECT_ID overrides below.
                              # Capella UI → select your Organization → Settings → API Keys →
                              # Generate Key → name it → check Organization Owner (leave other
                              # roles/expiry/IP at defaults) → Generate -> copy or DOWNLOAD the key (shown once, so download to be safe)
                              # (paste the APIKeyToken value from the downloaded file -- shown as "API Secret" in the UI) — it can't be retrieved later.

# ── App-specific — must match your generated app (the recipe pre-fills these) ─
export CB_ENDPOINT_NAME='inventorycount'                  # App Endpoint name — make it app-specific
export APPSVC_ADMIN_USER='inventorycountadmin'            # Admin Credential name — MUST be unique per app.
                                                 # Do NOT use the generic 'admin': Admin Credentials are
                                                 # App-Services-scoped (one credential covers ALL App Endpoints
                                                 # in the App Service) and their passwords can't be read back or
                                                 # updated. A shared 'admin' from another app in the same App
                                                 # Service would otherwise collide. Use e.g. '<endpoint>admin'.
                                                 # (The recipe sets this to match your app.)
export COLLECTIONS='inventory/counts inventory/catalogue inventory/locations'             # space-separated scope/collection pairs;
                                                 # MUST match AppConfig.swift and the *-sync-function.js filenames
export SYNC_FUNCTIONS_DIR='sync-functions'       # folder with the <collection>-sync-function.js files.
                                                 # Resolved relative to setup-capella.sh's own location
                                                 # (the script sits in the project next to sync-functions/),
                                                 # so use just 'sync-functions' — NO project-name prefix.

# ── App Services Admin Credential password — optional, leave blank ──────────
export APPSVC_ADMIN_PASS=''   # Leave blank: setup-capella.sh generates a strong password on the
                              # first run and saves it back here — it is never printed anywhere,
                              # including in this file's own comments or the script's output.
                              # To set your own instead, put it here directly (single-quoted, to
                              # avoid bash expanding !): 8+ chars incl. upper, lower, number, special.
                              # AVOID '=' and '&' — Capella's Admin Credential API rejects both (HTTP 422,
                              # confirmed empirically). Stick to '!', '@', '+' as specials if unsure.
export FORCE_ADMIN_CRED_ROTATE=''   # Leave blank (recommended). The script normally skips recreating
                              # this Admin Credential on a re-run when the App Service was found already
                              # existing (reused/shared, not created by this script) — rotating it there
                              # gains nothing (same user/pass either way) and briefly invalidates it for
                              # whatever else relies on that App Service. Set to 'true' only if you've hand-
                              # edited APPSVC_ADMIN_PASS above and need that new value pushed through now.

# ── Default logins created by the script (override if you want) ─────────────
export MANAGER_USER='manager'    # App User that holds the admin role
export MANAGER_PASS='' # Leave as-is or blank — both default to 'Password1!'. These are
                                 # low-privilege test accounts you'll type into the app to sign in,
                                 # so a static password is fine. Edit here to set your own.
export BOB_PASS=''     # default regular App User 'bob' — same note as MANAGER_PASS above.

# ── Capella infra — defaults are fine for most; change only on conflict ─────
export CB_PROJECT_NAME='MobileDevProject'
export CB_CLUSTER_NAME='mobile-dev-cluster'
export CB_BUCKET_NAME='inventorycount'
export CB_APP_SERVICE_NAME='mobile-app-service'
export CLOUD_PROVIDER='aws'          # aws (default), gcp, azure
export CLOUD_REGION='us-east-2'
export CLOUD_CIDR='10.0.64.0/23'     # change only if it conflicts with an existing cluster
export FREE_TIER='true'              # 'false' for a standard cluster (auto-switches if the cluster isn't free tier)

# ── Project-scoped key / existing standard cluster (optional) ────────────────
# A Project Owner API key cannot list organizations (HTTP 403), so give the IDs explicitly.
# Find them in the Capella console URL: /organizations/<id>/projects/<id>/clusters/<id>/...
export CB_ORGANIZATION_ID=''    # Organization UUID (required for Project Owner keys)
export CB_PROJECT_ID='' # Project UUID — adopt it directly, skip name lookup
export CB_CLUSTER_ID='' # Existing cluster UUID — adopt it directly, never create
export APP_SERVICE_NODES='2'         # Standard clusters: 2–12 App Service nodes (1 fails with 422)
export CB_BUCKET_RAM_MB='128'        # Bucket RAM for standard clusters; keep modest to fit quotas
